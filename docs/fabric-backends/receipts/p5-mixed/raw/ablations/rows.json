[
 {
  "id": "A05-D11",
  "rule": "I12: tool-call detection reads presence of `tools` or `functions`",
  "sabotage": "placement_requirements ignores `functions`",
  "file": "src/fabric/mod.rs",
  "old": "        tool_calls: present(\"tools\") || present(\"functions\"),",
  "new": "        tool_calls: present(\"tools\"),",
  "catchers": [
   "contents_of_equal_encoded_size_cannot_change_requirements_or_class"
  ],
  "cargo": [
   "--lib fabric::"
  ]
 },
 {
  "id": "A06-D12",
  "rule": "I12: placement never reads messages",
  "sabotage": "placement_requirements also scans messages for role:\"tool\"",
  "file": "src/fabric/mod.rs",
  "old": "        tool_calls: present(\"tools\") || present(\"functions\"),",
  "new": "        tool_calls: present(\"tools\") || present(\"functions\") || body.get(\"messages\").and_then(Value::as_array).is_some_and(|messages| messages.iter().any(|m| m.get(\"role\").and_then(Value::as_str) == Some(\"tool\"))),",
  "catchers": [
   "contents_of_equal_encoded_size_cannot_change_requirements_or_class"
  ],
  "cargo": [
   "--lib fabric::"
  ]
 },
 {
  "id": "A09-ready",
  "rule": "Readiness required under mixed mode",
  "sabotage": "is_placeable_under admits any node, ready or not, under Allowed",
  "file": "src/fabric/node.rs",
  "old": "        self.status.is_ready()\n            && (self.spec.engine.is_placeable() || mixed == super::policy::MixedEngines::Allowed)",
  "new": "        (self.status.is_ready() || mixed == super::policy::MixedEngines::Allowed)\n            && (self.spec.engine.is_placeable() || mixed == super::policy::MixedEngines::Allowed)",
  "catchers": [
   "mixed_placement_refuses_an_unreachable_node_exactly_as_camelid_only_placement_does",
   "mixed_placement_does_not_make_a_node_that_is_still_loading_eligible"
  ],
  "cargo": [
   "--lib fabric::"
  ]
 },
 {
