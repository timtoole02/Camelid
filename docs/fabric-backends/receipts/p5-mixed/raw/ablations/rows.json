 },
 {
  "id": "A13-D13",
  "rule": "Typed backpressure trusted only from an engine that declares it",
  "sabotage": "the re-place arm trusts engine_queue_full from any engine",
  "file": "src/fabric/mod.rs",
  "old": "                Ok(value) if trusted_backpressure(&placement, &value) => {",
  "new": "                Ok(value) if value.refused_for_backpressure() => {",
  "catchers": [
   "a_foreign_503_carrying_our_queue_full_code_is_still_relayed_once",
   "a_streaming_request_refused_by_a_foreign_node_is_relayed_once"
  ],
  "cargo": [
   "--test fabric_engines"
  ]
 },
 {
  "id": "A11-D15b",
