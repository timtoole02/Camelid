  ]
 },
 {
  "id": "A14-D30",
  "rule": "Typed backpressure trusted only if declared, at the service-time site",
  "sabotage": "dispatch's service-time branch uses the ungated refused_for_backpressure()",
  "file": "src/fabric/mod.rs",
  "old": "        } else if sent.value.status >= 500 && !trusted_backpressure(&sent.placement, &sent.value) {",
  "new": "        } else if sent.value.status >= 500 && !sent.value.refused_for_backpressure() {",
  "catchers": [
   "completion_time_invalidates_a_foreign_node_whose_503_only_looks_typed"
  ],
  "cargo": [
   "--test fabric_serve"
  ]
 },
 {
  "id": "A15-relay",
  "rule": "Relay, don't re-place: an untyped refusal is relayed once (buffered and streaming)",
  "sabotage": "any 503 is read as a queue-full refusal",
  "file": "src/fabric/forward.rs",
  "old": "        self.status == 503\n            && self.body.pointer(\"/error/code\").and_then(Value::as_str)\n                == Some(ENGINE_QUEUE_FULL_CODE)",
  "new": "        self.status == 503",
  "catchers": [
   "a_refusal_that_is_not_backpressure_is_relayed_untouched",
   "an_untyped_refusal_of_a_stream_is_relayed_once_not_re_placed"
  ],
  "cargo": [
   "--test fabric_serve"
  ]
 },
 {
  "id": "A16-relay-stream",
  "rule": "Relay, don't re-place, on the streaming path",
  "sabotage": "a buffered answer to a stream re-placed on any 503",
  "file": "src/fabric/forward.rs",
  "old": "            Self::Buffered(answer) => answer.refused_for_backpressure(),",
  "new": "            Self::Buffered(answer) => answer.status == 503,",
  "catchers": [
   "an_untyped_refusal_of_a_stream_is_relayed_once_not_re_placed"
  ],
  "cargo": [
   "--test fabric_serve"
  ]
 },
