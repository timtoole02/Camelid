 {
  "id": "A01-D9",
  "rule": "I5: a tool-carrying request never reaches an unmeasured backend",
  "sabotage": "meets() passes every node whatever tool_calls says",
  "file": "src/fabric/policy.rs",
  "old": "    if requires.tool_calls && capabilities.tool_calls.supported != Some(true) {",
  "new": "    if requires.tool_calls && capabilities.tool_calls.supported != Some(true) && false {",
  "catchers": [
   "a_tool_calling_request_never_lands_on_a_backend_nobody_measured",
   "a_request_carrying_tools_is_never_sent_to_an_unmeasured_engine",
   "a_tool_calling_request_through_the_proxy_is_refused_with_what_to_do_next"
  ],
  "cargo": [
   "--lib fabric::policy",
   "--test fabric_engines",
   "--test fabric_serve"
  ]
 },
 {
  "id": "A02-D10",
  "rule": "I5 at the chokepoint: Fabric::dispatch reads the body's requirements itself",
  "sabotage": "the requirements union deleted from Fabric::dispatch (policy unit tests must stay green)",
  "file": "src/fabric/mod.rs",
  "old": "        // caller may add a requirement, never take one the body carries away.\n        let request = request.requiring(request.requires.union(placement_requirements(path, body)));",
  "new": "        // caller may add a requirement, never take one the body carries away.\n        let request = *request;",
  "catchers": [
   "a_request_carrying_tools_is_never_sent_to_an_unmeasured_engine",
   "a_tool_calling_request_through_the_proxy_is_refused_with_what_to_do_next"
  ],
  "cargo": [
   "--lib fabric::policy",
   "--test fabric_engines",
   "--test fabric_serve"
  ]
 },
 {
  "id": "A03-D10b",
  "rule": "I5 at the chokepoint, streaming",
  "sabotage": "the requirements union deleted from Fabric::dispatch_streaming only",
  "file": "src/fabric/mod.rs",
  "old": "        // The same chokepoint as `dispatch`: see there.\n        let request = request.requiring(request.requires.union(placement_requirements(path, body)));",
  "new": "        // The same chokepoint as `dispatch`: see there.\n        let request = *request;",
  "catchers": [
   "a_streaming_request_carrying_tools_is_never_sent_to_an_unmeasured_engine"
  ],
  "cargo": [
   "--test fabric_engines"
  ]
 },
 {
  "id": "A04-D29",
  "rule": "I5 on the one-shot path",
  "sabotage": "Fabric::forward_to checks no requirement",
  "file": "src/fabric/mod.rs",
  "old": "        if let Err(missing) =\n            policy::meets(&node.capabilities(), placement_requirements(path, body))",
  "new": "        if let Err(missing) =\n            policy::meets(&node.capabilities(), Requirements::default())",
  "catchers": [
   "a_one_shot_send_refuses_a_tool_carrying_body_for_a_node_not_measured_for_it"
  ],
  "cargo": [
   "--test fabric_engines"
  ]
 },
 {
