{"source": "author-written", "row": 21, "text_sha256": "f0c8f1860044529c1aa1676f12ca5323095d7329da7ada36f4db079c73c7365d", "text": "good night"}
{"source": "author-written", "row": 22, "text_sha256": "bb36f57782ca24e8c4bf12ba601abc5d3b3bfb8036415dc3f9af205687f94631", "text": "sounds good"}
{"source": "author-written", "row": 23, "text_sha256": "fdc6e200ad426c7ea3e84b57c756e1dfc7db27aa8573ebb51dd662cc55691609", "text": "let's start over"}
{"source": "author-written", "row": 24, "text_sha256": "79694e48b8a1b77fe07b8f39d799cd11911353a93846133570c6312b8324f053", "text": "explain that again more simply"}
