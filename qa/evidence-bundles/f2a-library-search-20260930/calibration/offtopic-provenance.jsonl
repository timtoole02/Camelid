{"source": "author-written", "row": 8, "text_sha256": "2689367b205c16ce32ed4200942b8b8b1e262dfc70d9bc9fbc77c49699a4f1df", "text": "ok"}
{"source": "author-written", "row": 9, "text_sha256": "c34045c1a1db8d1b3fca8a692198466952daae07eaf6104b4c87ed3b55b6af1b", "text": "cool"}
{"source": "author-written", "row": 10, "text_sha256": "eb5c10fe18d9750934fedf2059ebfd1fccadce64217a583b783ff10959072c1a", "text": "tell me a joke"}
{"source": "author-written", "row": 11, "text_sha256": "2bfaf27f4f2719f645e4fd616afb6cfa517ce31a5363366eebb6ffa3038b39f3", "text": "can you help me?"}
{"source": "author-written", "row": 12, "text_sha256": "f8f5a98a5482e0be9cbf031a890573368eafb5150421f786abfd039fe1286033", "text": "what's your name?"}
{"source": "author-written", "row": 13, "text_sha256": "b49f425a7e1f9cff3856329ada223f2f9d368f15a00cf48df16ca95986137fe8", "text": "bye"}
