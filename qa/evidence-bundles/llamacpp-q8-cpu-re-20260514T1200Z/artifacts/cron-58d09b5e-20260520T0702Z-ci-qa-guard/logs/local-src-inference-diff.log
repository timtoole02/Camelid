+    #[test]
+    fn q8_attention_output_gemm4_prefill_matches_runtime_packed_matmul_with_tail() {
+        let _env_guard = env_lock();
+        clear_dense_diagnostic_env();
+        let (_decode_input, packed_weight, _decode_expected) =
+            runtime_packed_attention_projection_case(
+                "attention_output",
+                "blk.0.attn_output.weight",
+            );
+        let input_width = packed_weight.dim(0).unwrap();
+        let output_width = packed_weight.dim(1).unwrap();
+        let rows = 7;
+        let input = CpuTensor::from_f32(
+            "attention_output_gemm4_prefill_input",
+            vec![rows, input_width],
+            (0..rows * input_width)
+                .map(|idx| {
+                    ((idx % input_width) as f32 - 7.0) * 0.078125
+                        + (idx / input_width) as f32 * 0.0390625
+                })
+                .collect(),
+        )
+        .unwrap();
+        let packed = match packed_weight.q8_0_runtime_storage.as_ref() {
+            Some(Q8_0RuntimeStorage::PackedRows4(packed)) => packed,
+            other => panic!("expected runtime-packed rows4 weight, got {other:?}"),
+        };
+        let expected = q8_0_packed_rows4_matmul_projection(
+            &input,
+            packed,
+            output_width,
+            "expected_attention_output_matmul",
+        )
+        .unwrap();
+
+        let actual = try_x86_q8_attention_output_gemm4_prefill_path(
+            &input,
+            &packed_weight,
+            "actual_attention_output_gemm4_prefill",
+            "linear",
+            &attention_output_gemm4_prefill_plan(true),
+        )
+        .unwrap()
+        .expect("attention output GEMM4 prefill should accept rows>=4 runtime-packed weights");
+
+        assert_eq!(actual.shape.dims, vec![rows, output_width]);
+        assert_slice_close_with_tolerance(&actual.data, &expected.data, 5e-4);
+    }
+
