{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Camelid Desktop",
  "version": "0.6.1",
  "identifier": "app.camelid.desktop",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Camelid Desktop",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0e1216",
        "url": "index.html",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "spotlight",
        "title": "Camelid Spotlight",
        "width": 640,
        "height": 400,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "url": "index.html#spotlight"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Camelid",
    "category": "DeveloperTool",
    "shortDescription": "Native chat app for the Camelid local inference engine.",
    "longDescription": "Camelid Desktop embeds the same Camelid engine shipped as the server binary and runs it as a loopback sidecar. It inherits the identical model-support contract; it makes no broader claims.",
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
